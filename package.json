{
	"name": "issues-obsidian",
	"version": "0.1.3",
	"description": "A sectioned issue list for Obsidian Bases.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"install:vault": "npm run build && node scripts/install-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"dependencies": {
		"fractional-indexing": "^3.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/maxhuk/issues-obsidian.git"
	},
	"license": "MIT"
}
